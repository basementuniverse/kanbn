#compdef kanbn
#
# zsh completion for kanbn
#
# Generated by `kanbn completion zsh`. Either save it as _kanbn in a directory on your $fpath:
#
#   kanbn completion zsh > ~/.zsh/completions/_kanbn
#
# or load it from ~/.zshrc, after compinit:
#
#   eval "$(kanbn completion zsh)"

_kanbn() {
  local -a lines candidates timeout
  local line value description

  # Give up rather than hang the shell if completion ever takes too long
  if (( $+commands[timeout] )); then
    timeout=(timeout 0.25)
  elif (( $+commands[gtimeout] )); then
    timeout=(gtimeout 0.25)
  fi

  # Only the words up to and including the one being completed
  lines=("${(@f)$($timeout kanbn __complete -- "${(@)words[1,CURRENT]}" 2>/dev/null)}")
  for line in "${lines[@]}"; do
    [[ -z $line || $line == :* ]] && continue
    value=${line%%$'\t'*}
    description=
    [[ $line == *$'\t'* ]] && description=${line#*$'\t'}

    # _describe splits each candidate at its first unescaped colon
    candidates+=("${value//:/\\:}${description:+:$description}")
  done
  (( ${#candidates} )) || return 1
  _describe -t kanbn kanbn candidates
}

if [[ $funcstack[1] == _kanbn ]]; then
  _kanbn "$@"
else
  compdef _kanbn kanbn
fi
