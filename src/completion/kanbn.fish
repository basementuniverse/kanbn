# fish completion for kanbn
#
# Generated by `kanbn completion fish`. Save it where fish looks for completions:
#
#   kanbn completion fish > ~/.config/fish/completions/kanbn.fish

function __kanbn_complete
    # Only the words up to and including the one being completed
    set -l words (commandline -opc) (commandline -ct)

    # Give up rather than hang the shell if completion ever takes too long
    if command -q timeout
        timeout 0.25 kanbn __complete -- $words 2>/dev/null | string match -v -r '^:'
    else if command -q gtimeout
        gtimeout 0.25 kanbn __complete -- $words 2>/dev/null | string match -v -r '^:'
    else
        kanbn __complete -- $words 2>/dev/null | string match -v -r '^:'
    end
end

complete -c kanbn -f -a '(__kanbn_complete)'
